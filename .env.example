# =====================================================================
# Solfège Progression — variables d'environnement
# Copier ce fichier en `.env.local` (jamais commité) et compléter.
# =====================================================================
#
# ÉTAPE ACTUELLE (laboratoire de lecture des notes) : AUCUNE variable n'est
# nécessaire. L'application fonctionne sans compte et enregistre les
# résultats sur l'appareil de l'élève.
#
# ÉTAPE 7 (authentification et espaces formateur / élève) : Supabase.

# URL du projet : Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Clé PUBLIQUE (« publishable » / « anon ») : visible dans le navigateur, c'est normal.
# La protection des données repose sur les politiques Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé SECRÈTE (« secret » / « service_role ») : UNIQUEMENT côté serveur
# (Route Handlers / Server Actions). Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
