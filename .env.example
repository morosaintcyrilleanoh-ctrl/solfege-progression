# =====================================================================
# Solfège Progression — variables d'environnement
# Copier en `.env.local` (jamais commité) pour le développement ;
# les saisir dans Vercel > Settings > Environment Variables en production.
# Sans ces variables, le site fonctionne sans compte (laboratoires seuls).
# Guide : docs/SUPABASE.md et docs/DEPLOIEMENT.md
# =====================================================================

# URL du projet : Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=

# Clé PUBLIQUE (« publishable » / « anon ») : visible dans le navigateur, c'est normal.
# La protection des données repose sur les règles de la base (RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Adresse publique du site (liens des e-mails de confirmation et de mot de passe).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# NE PAS définir dans Vercel. Uniquement pour `node scripts/seed-demo.mjs`
# lancé en local. Ne jamais commiter ni préfixer par NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
