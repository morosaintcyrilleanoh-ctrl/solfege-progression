# Copier en .env.local pour le développement, ou saisir dans
# Vercel > Settings > Environment Variables pour la production.
# Toutes ces variables sont FACULTATIVES.

# Adresse qui reçoit les formulaires d'inscription (POST JSON).
# Ex. : un formulaire Formspree, un webhook Make/Zapier, ou votre propre API.
# Vide = l'inscription est envoyée par WhatsApp (si le numéro est configuré).
VITE_INSCRIPTION_ENDPOINT=

# Point d'entrée du paiement en ligne (fonction serveur dans api/paiement/initier.js).
# Laisser vide tant qu'aucun prestataire Mobile Money / carte n'est branché.
VITE_PAIEMENT_ENDPOINT=

# ---------------------------------------------------------------------
# Côté serveur uniquement (jamais préfixé par VITE_) : clés du prestataire
# de paiement, lues par les fonctions du dossier api/.
# PAIEMENT_CLE_SECRETE=
